# =============================================================================
# FlashPipe - High-Throughput Event Ingestion System
# =============================================================================

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
SERVER_PORT=8181
SERVER_PREFORK=true
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=30s
SERVER_BODY_LIMIT=4194304          # 4MB max request body
SERVER_CONCURRENCY=262144          # Max concurrent connections

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
LOG_LEVEL=info                     # debug, info, warn, error, fatal
LOG_PRETTY=false                   # Human-readable logs (disable in production)

# -----------------------------------------------------------------------------
# Kafka/Redpanda Configuration
# -----------------------------------------------------------------------------
KAFKA_BROKERS=localhost:9092       # Comma-separated broker addresses
KAFKA_TOPIC=events.raw             # Default topic for raw events
KAFKA_BATCH_SIZE=1000              # Messages per batch
KAFKA_BATCH_TIMEOUT=10ms           # Max wait time before sending batch
KAFKA_REQUIRED_ACKS=1              # 0=none, 1=leader, -1=all
KAFKA_ASYNC=true                   # Async mode for higher throughput

# -----------------------------------------------------------------------------
# Redis Configuration (for idempotency, rate limiting, distributed locking)
# -----------------------------------------------------------------------------
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=50                 # Connection pool size
REDIS_MIN_IDLE_CONNS=10            # Minimum idle connections
REDIS_MAX_RETRIES=3                # Max retry attempts

# -----------------------------------------------------------------------------
# ERP Workflow Topics (optional - for workflow-specific routing)
# -----------------------------------------------------------------------------
# KAFKA_TOPIC_PAYROLL=erp.payroll
# KAFKA_TOPIC_ATTENDANCE=erp.attendance
# KAFKA_TOPIC_TRIAL_BALANCE=erp.trial-balance
